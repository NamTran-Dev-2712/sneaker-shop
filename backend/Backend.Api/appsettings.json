{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CloudinarySettings": {
    "CloudName": "dzzzzzzzz",
    "ApiKey": "1234567890",
    "ApiSecret": "abcdefghij"
  },
  "JwtSettings": {
    "AccessSecretKey": "your_jwt_secret_key",
    "RefreshSecretKey": "your_refresh_jwt_secret_key",
    "Issuer": "your_issuer",
    "Audience": "your_audience",
    "AccessExpirationInMinutes": 60,
    "RefreshExpirationInDays": 7
  },
  "GoogleOAuth": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
    "Scope": "openid email profile"
  },
  "VnPay": {
    "Enabled": false,
    "TmnCode": "YOUR_VNPAY_TMN_CODE",
    "HashSecret": "YOUR_VNPAY_HASH_SECRET",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "http://localhost:5173/checkout/vnpay-return",
    "Version": "2.1.0",
    "Command": "pay",
    "CurrCode": "VND",
    "Locale": "vn",
    "OrderType": "other",
    "ExpireInMinutes": 2,
    "PendingCleanupEnabled": true,
    "PendingCleanupIntervalSeconds": 30,
    "AutoCancelAfterMinutes": 2,
    "PendingCleanupBatchSize": 100
  },
  "AppSettings": {
    "BaseUrl": "http://localhost:5000",
    "FrontendUrl": "http://localhost:5173"
  },
  "AllowOrigins": "http://localhost:3000,http://localhost:5173,http://my_frontend:3000",
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=sneaker_shop;Username=postgres;Password=password"
  },
  "EmailSettings": {
    "EmailAddress": "your_email@example.com",
    "DisplayName": "Your Display Name",
    "Password": "your_email_password",
    "Host": "smtp.example.com",
    "Port": 587
  }
