@inherits RazorLight.TemplatePage<StaffCredentialsModel>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thông tin tài khoản nhân viên</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f4;
        }
        .email-container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .header {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            padding: 40px 20px;
            text-align: center;
        }
        .header h1 {
            color: #ffffff;
            margin: 0;
            font-size: 26px;
            font-weight: 600;
        }
        .header p {
            color: #a0aec0;
            margin: 8px 0 0 0;
            font-size: 14px;
        }
        .content {
            padding: 40px 30px;
        }
        .greeting {
            font-size: 18px;
            color: #333333;
            margin-bottom: 16px;
        }
        .message {
            font-size: 15px;
            color: #555555;
            line-height: 1.7;
            margin-bottom: 28px;
        }
        .credentials-box {
            background-color: #f8f9fa;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 24px;
            margin-bottom: 28px;
        }
        .credentials-box h3 {
            margin: 0 0 16px 0;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #718096;
        }
        .credential-row {
            display: flex;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #edf2f7;
        }
        .credential-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }
        .credential-label {
            width: 130px;
            font-size: 13px;
            color: #718096;
            font-weight: 500;
        }
        .credential-value {
            font-size: 15px;
            color: #2d3748;
            font-weight: 600;
            font-family: 'Courier New', monospace;
            background-color: #edf2f7;
            padding: 4px 10px;
            border-radius: 4px;
        }
        .warning {
            margin-top: 20px;
            padding: 16px;
            background-color: #fff3cd;
            border-left: 4px solid #f6ad55;
            border-radius: 4px;
            font-size: 14px;
            color: #744210;
            line-height: 1.6;
        }
        .store-badge {
            display: inline-block;
            background-color: #ebf8ff;
            color: #2b6cb0;
            font-size: 13px;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 20px;
            margin-bottom: 20px;
        }
        .footer {
            padding: 24px 30px;
            text-align: center;
            background-color: #f8f9fa;
            border-top: 1px solid #e2e8f0;
        }
        .footer p {
            margin: 4px 0;
            font-size: 13px;
            color: #a0aec0;
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            <div style="font-size: 48px; margin-bottom: 12px;">👟</div>
            <h1>Sneaker Shop</h1>
            <p>Thông tin tài khoản nhân viên</p>
        </div>
        <div class="content">
            <div class="greeting">
                Xin chào, <strong>@Model.FullName</strong>!
            </div>
            <div class="message">
                Chào mừng bạn đến với đội ngũ <strong>Sneaker Shop</strong>. Tài khoản nhân viên của bạn đã được tạo thành công.
                <br><br>
                Dưới đây là thông tin đăng nhập của bạn. Vui lòng đăng nhập và đổi mật khẩu ngay sau lần đăng nhập đầu tiên.
            </div>

            <span class="store-badge">📍 Chi nhánh: @Model.StoreName</span>

            <div class="credentials-box">
                <h3>🔐 Thông tin đăng nhập</h3>
                <div class="credential-row">
                    <span class="credential-label">Email</span>
                    <span class="credential-value">@Model.Email</span>
                </div>
                <div class="credential-row">
                    <span class="credential-label">Mật khẩu</span>
                    <span class="credential-value">@Model.Password</span>
                </div>
            </div>

            <div class="warning">
                ⚠️ <strong>Lưu ý bảo mật:</strong> Mật khẩu này được tạo tự động. Vui lòng <strong>đổi mật khẩu ngay</strong> sau lần đăng nhập đầu tiên để đảm bảo an toàn tài khoản. Không chia sẻ thông tin đăng nhập với bất kỳ ai.
            </div>
        </div>
        <div class="footer">
            <p><strong>Sneaker Shop</strong></p>
            <p>Hệ thống quản lý nội bộ</p>
            <p style="margin-top: 12px;">
                Cần hỗ trợ? Liên hệ quản trị viên hoặc email
                <a href="mailto:support@sneakershop.vn" style="color: #667eea;">support@sneakershop.vn</a>
            </p>
        </div>
    </div>
</body>
</html>
