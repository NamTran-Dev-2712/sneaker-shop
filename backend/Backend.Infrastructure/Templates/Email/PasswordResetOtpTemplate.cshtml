@inherits RazorLight.TemplatePage<PasswordResetOtpModel>
<!doctype html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mã OTP đặt lại mật khẩu</title>
</head>
<body style="margin:0;padding:0;background:#f6f7fb;font-family:Arial,Helvetica,sans-serif;color:#111827;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="padding:24px 12px;">
        <tr>
            <td align="center">
                <table role="presentation" width="560" cellspacing="0" cellpadding="0" style="max-width:560px;background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 8px 24px rgba(15,23,42,0.08);">
                    <tr>
                        <td style="padding:24px 28px;background:#111827;color:#ffffff;">
                            <h1 style="margin:0;font-size:20px;line-height:1.4;">Sneaker Shop</h1>
                            <p style="margin:6px 0 0;font-size:13px;opacity:0.9;">Mã OTP đặt lại mật khẩu</p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:28px;">
                            <p style="margin:0 0 12px;font-size:15px;line-height:1.6;">
                                Bạn vừa yêu cầu đặt lại mật khẩu. Vui lòng nhập mã OTP dưới đây để tiếp tục:
                            </p>

                            <div style="margin:18px 0;padding:14px 18px;background:#f3f4f6;border-radius:10px;border:1px dashed #9ca3af;text-align:center;">
                                <span style="font-size:30px;letter-spacing:8px;font-weight:700;color:#111827;">@Model.OtpCode</span>
                            </div>

                            <p style="margin:0 0 8px;font-size:14px;line-height:1.6;color:#374151;">
                                Mã có hiệu lực trong <strong>5 phút</strong> và chỉ dùng được một lần.
                            </p>
                            <p style="margin:0;font-size:14px;line-height:1.6;color:#374151;">
                                Nếu bạn không thực hiện yêu cầu này, hãy bỏ qua email này.
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:16px 28px;background:#f9fafb;border-top:1px solid #e5e7eb;">
                            <p style="margin:0;font-size:12px;color:#6b7280;line-height:1.6;">
                                Đây là email tự động, vui lòng không trả lời email này.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
